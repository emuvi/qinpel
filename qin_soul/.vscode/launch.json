{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "QinSoul",
            "url": "http://localhost:8080/",
            "userDataDir": "${workspaceFolder}/.vscode/chrome_debug",
            "sourceMapPathOverrides": {
                "webpack:///./build/dics/*": "${workspaceFolder}/../qin_desk/build/dics/*",
                "webpack:///./build/qin*": "${workspaceFolder}/../qin_desk/build/qin*",
                "webpack:///./build/desk.js": "${workspaceFolder}/../qin_desk/build/desk.js",
                "webpack:///./build/index.js": "${workspaceFolder}/../qin_desk/build/index.js",
                "webpack:///./build/login.js": "${workspaceFolder}/../qin_desk/build/login.js",
                "webpack:///./build/main.js": "${workspaceFolder}/../qin_desk/build/main.js",
                "webpack:///./~/*": "${webRoot}/node_modules/*",
                "webpack:////*": "/*",
                "webpack://@?:*/?:*/*": "${webRoot}/*",
                "webpack://?:*/*": "${webRoot}/*",
                "webpack:///([a-z]):/(.+)": "$1:/$2"
            }
        }
    ]
}